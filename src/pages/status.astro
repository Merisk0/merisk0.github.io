---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl, formatDate, formatYear, groupByTag } from '../utils';

const posts = await getPosts();
const total = posts.length;
const encrypted = posts.filter((post) => post.data.protected).length;
const openCount = total - encrypted;
const tagGroups = groupByTag(posts);
const totalChars = posts.reduce(
  (sum, post) => sum + (post.body ?? '').replace(/<[^>]*>/g, '').replace(/\n/g, '').length,
  0,
);
const nowDate = new Date();
const cutoff = nowDate.valueOf() - 30 * 24 * 60 * 60 * 1000;
const recentCount = posts.filter((post) => post.data.date.valueOf() >= cutoff).length;
const pad = (n: number) => String(n).padStart(2, '0');
const buildVersion = `${nowDate.getFullYear()}${pad(nowDate.getMonth() + 1)}${pad(nowDate.getDate())}${pad(nowDate.getHours())}${pad(nowDate.getMinutes())}`;
const buildTime = `${formatDate(nowDate)} ${pad(nowDate.getHours())}:${pad(nowDate.getMinutes())}`;

// 年份分布
const yearMap = new Map<string, number>();
for (const post of posts) {
  const year = formatYear(post.data.date);
  yearMap.set(year, (yearMap.get(year) ?? 0) + 1);
}
const years = [...yearMap.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));

// 环形图：极坐标 + 圆弧路径
const polar = (cx: number, cy: number, r: number, deg: number) => {
  const rad = ((deg - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(rad), cy + r * Math.sin(rad)] as const;
};
const arcPath = (cx: number, cy: number, rOuter: number, rInner: number, start: number, end: number) => {
  const safeEnd = Math.min(end, 359.99);
  const [x1, y1] = polar(cx, cy, rOuter, start);
  const [x2, y2] = polar(cx, cy, rOuter, safeEnd);
  const [x3, y3] = polar(cx, cy, rInner, safeEnd);
  const [x4, y4] = polar(cx, cy, rInner, start);
  const large = safeEnd - start > 180 ? 1 : 0;
  const f = (n: number) => n.toFixed(2);
  return `M${f(x1)} ${f(y1)} A${rOuter} ${rOuter} 0 ${large} 1 ${f(x2)} ${f(y2)} L${f(x3)} ${f(y3)} A${rInner} ${rInner} 0 ${large} 0 ${f(x4)} ${f(y4)} Z`;
};
const toSlices = (items: Array<{ label: string; value: number; color: string }>) => {
  const sum = items.reduce((acc, item) => acc + item.value, 0) || 1;
  let angle = 0;
  return items.map((item) => {
    const span = (item.value / sum) * 360;
    const path = arcPath(60, 60, 52, 40, angle, angle + span);
    angle += span;
    const percent = Math.round((item.value / sum) * 100);
    return { ...item, path, percent, tip: `${item.label} · ${item.value} 篇 · ${percent}%` };
  });
};

const encSlices = toSlices([
  { label: '已加密', value: encrypted, color: 'var(--brand)' },
  { label: '公开', value: openCount, color: 'var(--surface-soft-strong)' },
]);
const yearSlices = toSlices(
  years.map(([year, count], index) => ({
    label: `${year} 年`,
    value: count,
    color: `color-mix(in srgb, var(--brand) ${86 - index * 13}%, var(--surface-soft-strong))`,
  })),
);
---

<BaseLayout title="状态" description="Merisk'B1og 的内容数据与构成。" bodyClass="single scholar">
  <main class="main container" id="main-content">
    <header class="page-header">
      <div class="breadcrumbs">
        <a href="/">首页</a>
      </div>
      <h1>状态</h1>
      <p class="scholar-note">
        <span class="status-dot" aria-hidden="true"></span>
        运行中 · 构建于 {buildTime} · 近 30 天更新 <b>{recentCount}</b> 篇
      </p>
    </header>

    <section class="scholar-block">
      <h2>内容概览</h2>
      <ul class="scholar-list scholar-list-kv">
        <li><span>文章</span><span><b>{total}</b> 篇</span></li>
        <li><span>标签</span><span><b>{tagGroups.length}</b> 个</span></li>
        <li><span>年份跨度</span><span>{years[years.length - 1][0]} – {years[0][0]}<b></b></span></li>
        <li><span>已加密</span><span><b>{encrypted}</b> 篇 · 占 {Math.round((encrypted / total) * 100)}%</span></li>
        <li><span>公开正文</span><span><b>{totalChars}</b> 字</span></li>
      </ul>
    </section>

    <section class="scholar-block">
      <h2>构成</h2>
      <div class="charts">
        <figure class="chart">
          <svg viewBox="0 0 120 120" class="donut" role="img" aria-label={`共 ${total} 篇，其中已加密 ${encrypted} 篇`}>
            {encSlices.map((slice) => (
              <path class="pie-slice" d={slice.path} style={`fill:${slice.color}`} data-tip={slice.tip}></path>
            ))}
          </svg>
          <figcaption>
            {encSlices.map((slice) => (
              <span class="chart-key" data-tip={slice.tip}>
                <i style={`background:${slice.color}`}></i>{slice.label} {slice.value} 篇 · {slice.percent}%
              </span>
            ))}
          </figcaption>
        </figure>

        <figure class="chart">
          <svg viewBox="0 0 120 120" class="donut" role="img" aria-label={`跨 ${years.length} 个年份`}>
            {yearSlices.map((slice) => (
              <path class="pie-slice" d={slice.path} style={`fill:${slice.color}`} data-tip={slice.tip}></path>
            ))}
          </svg>
          <figcaption>
            {yearSlices.map((slice) => (
              <span class="chart-key" data-tip={slice.tip}>
                <i style={`background:${slice.color}`}></i>{slice.label.replace(' 年', '')} {slice.value} 篇
              </span>
            ))}
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="scholar-block">
      <h2>标签分布</h2>
      <ul class="scholar-list">
        {tagGroups.map(([tag, items]) => (
          <li
            data-tip={`${tag} · ${items.length} 篇 · 占 ${Math.round((items.length / total) * 100)}% · ${items.slice(0, 2).map((post) => post.data.title).join('、')}${items.length > 2 ? ' 等' : ''}`}
          >
            <a class="scholar-title" href={`/tags.html#tag-${tag}`}>{tag}</a>
            <span class="scholar-meta">
              {items.length} 篇 · 占 {Math.round((items.length / total) * 100)}%
              <span class="scholar-sep" aria-hidden="true">—</span>
              {items.slice(0, 2).map((post) => post.data.title).join('、')}{items.length > 2 ? ' 等' : ''}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="scholar-block">
      <h2>最近更新</h2>
      <ul class="scholar-list">
        {posts.slice(0, 5).map((post) => (
          <li
            data-tip={`${formatDate(post.data.date)} · ${post.data.tags.length ? post.data.tags.map((tag) => `#${tag}`).join(' ') : '无标签'} · ${post.data.protected ? '正文已加密' : '正文公开'}`}
          >
            <a class="scholar-title" href={postUrl(post)}>{post.data.title}</a>
            <span class="scholar-meta">
              {formatDate(post.data.date)}
              {post.data.tags.length > 0 && <><span class="scholar-sep" aria-hidden="true">—</span>{post.data.tags.map((tag) => `#${tag}`).join(' ')}</>}
              <span class="scholar-sep" aria-hidden="true">—</span>
              {post.data.protected ? '已加密' : '公开'}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="scholar-block">
      <h2>仓库与系统</h2>
      <ul class="scholar-list scholar-list-kv">
        <li><span>Stars</span><span data-github-stars>—</span></li>
        <li><span>Forks</span><span data-github-forks>—</span></li>
        <li><span>Open Issues</span><span data-github-issues>—</span></li>
        <li><span>提交数</span><span data-github-commits>—</span></li>
        <li><span>最近提交</span><span data-github-commit>—</span></li>
        <li><span>构建方式</span><span>Astro / GitHub Pages</span></li>
        <li><span>评论系统</span><span>giscus</span></li>
        <li><span>缓存版本</span><span>merisk-blog-v8</span></li>
        <li><span>构建版本</span><span>{buildVersion}</span></li>
      </ul>
    </section>
  </main>
</BaseLayout>
