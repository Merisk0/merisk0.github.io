---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" description="这个地址不存在，或者内容已经被移动。">
  <header class="main container page-header" id="main-content">
    <div class="breadcrumbs"><a href="/">首页</a><span class="crumb-separator" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"></path></svg></span><span>页面走丢了</span></div>
      <h1>页面走丢了</h1>
    <p>这个地址不存在，或者内容已经被移动。</p>
    <p><a class="btn" href="/">返回首页</a></p>
  </header>
</BaseLayout>
