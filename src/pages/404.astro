---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="页面未找到" description="这个地址不存在，或者内容已经被移动。">
  <header class="main container page-header" id="main-content">
    <Breadcrumbs />
      <h1>页面走丢了</h1>
    <p>这个地址不存在，或者内容已经被移动。</p>
    <p><a class="btn" href="/">返回首页</a></p>
  </header>
</BaseLayout>
