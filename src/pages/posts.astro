---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl, listingSummary, formatDate } from '../utils';

const posts = await getPosts();
---

<BaseLayout title="文章" description="Merisk'B1og 的全部文章，按时间倒序。">
  <main class="main container" id="main-content">
    <header class="page-header">
      <div class="breadcrumbs">
        <a href="/">首页</a>
      </div>
      <h1>文章</h1>
      <p>共 {posts.length} 篇 · 按时间倒序。</p>
    </header>

    <div id="article-grid">
      {posts.map((post, index) => (
        <article class="post-entry">
          <div class="entry-content-container">
            <header class="entry-header">
              <h2>{index === 0 && <span class="entry-badge">最新</span>}{post.data.title}</h2>
            </header>
            <div class="entry-content">
              <p>{listingSummary(post)}</p>
            </div>
            <footer class="entry-footer">
              <span>{formatDate(post.data.date)}</span>
            </footer>
          </div>
          <a class="entry-link" href={postUrl(post)} aria-label={`打开文章 ${post.data.title}`}></a>
        </article>
      ))}
    </div>

    <div class="load-more-wrap">
      <button class="button" id="load-more" type="button">加载更多</button>
      <button class="button" id="load-less" type="button" hidden>加载更少</button>
      <span class="load-status" id="load-status" aria-live="polite"></span>
    </div>
  </main>

  <script is:inline>
  const articleCards = Array.from(document.querySelectorAll('#article-grid .post-entry'));
  const loadMore = document.getElementById('load-more');
  const loadLess = document.getElementById('load-less');
  const loadStatus = document.getElementById('load-status');
  const pageSize = 8;
  let visibleLimit = pageSize;

  function applyArticlePaging(){
    articleCards.forEach((card, index) => { card.hidden = index >= visibleLimit; });
    if(loadMore) loadMore.hidden = visibleLimit >= articleCards.length;
    if(loadLess) loadLess.hidden = visibleLimit <= pageSize;
    if(loadStatus) loadStatus.textContent = '已显示 ' + Math.min(visibleLimit, articleCards.length) + ' / ' + articleCards.length + ' 篇';
  }

  if(loadMore) loadMore.addEventListener('click', () => { visibleLimit += pageSize; applyArticlePaging(); });
  if(loadLess) loadLess.addEventListener('click', () => { visibleLimit = Math.max(pageSize, visibleLimit - pageSize); applyArticlePaging(); });
  applyArticlePaging();
  </script>
</BaseLayout>
