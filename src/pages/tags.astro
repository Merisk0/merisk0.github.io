---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl, groupByTag, listingSummary } from '../utils';

const posts = await getPosts();
const tagGroups = groupByTag(posts);
const taggedCount = posts.filter((post) => post.data.tags.length > 0).length;
---

<BaseLayout title="标签" description="按标签浏览 Merisk'B1og 的全部文章。" bodyClass="single">
  <main class="main container" id="main-content">
    <article class="post-single">
      <header class="post-header">
        <div class="breadcrumbs">
          <a href="/">首页</a>
        </div>
        <h1 class="post-title">标签</h1>
        <div class="post-meta">
          <span>{tagGroups.length} 个标签</span>
          &nbsp;·&nbsp;<span>{taggedCount} 篇已标记</span>
          &nbsp;·&nbsp;<span>{posts.length} 篇文章</span>
        </div>
      </header>

      <div class="post-content">
        <div class="search-toolbar">
          <label class="search-box">
            <span>搜索</span>
            <input id="tag-search" type="search" placeholder="搜索标签…" autocomplete="off">
          </label>
          <div class="search-count" id="tag-count">{tagGroups.length} 个标签</div>
        </div>

        <div class="tag-overview" aria-label="标签概览">
          {tagGroups.map(([tag, items]) => (
            <a class="tag-chip" data-tag-name={tag} href={`#tag-${tag}`}>
              <span>{tag}</span>
              <b>{items.length}</b>
            </a>
          ))}
        </div>

        {tagGroups.length > 0 ? tagGroups.map(([tag, items]) => (
          <section class="tag-section" id={`tag-${tag}`} data-tag-name={tag}>
            <div class="tag-section-head">
              <h2>{tag}</h2>
              <span class="tag-count">{items.length} 篇</span>
            </div>
            <div class="tag-post-list">
              {items.map((post) => (
                <a class="tag-post" href={postUrl(post)}>
                  <span class="tag-post-main">
                    <strong>{post.data.title}</strong>
                    {(post.data.summary || post.data.protected) && <small>{listingSummary(post)}</small>}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )) : (
          <div class="archive-empty"><strong>暂无标签</strong><span>给文章添加 tags 后会自动显示。</span></div>
        )}
      </div>
    </article>
  </main>
</BaseLayout>
