---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
import { getPosts, postUrl, groupByTag, formatDate, formatYear } from '../utils';

const posts = await getPosts();
const tagGroups = groupByTag(posts);
const yearCount = new Set(posts.map((post) => formatYear(post.data.date))).size;
const latest = posts[0];
const postPool = JSON.stringify(posts.map((post) => postUrl(post)));
---

<BaseLayout title="" description={SITE.description} bodyClass="profile">
  <div class="home-banner">
    <img src="/img/banner-night.webp" alt="" width="1600" height="900" fetchpriority="high" draggable="false">
  </div>

  <main class="main container" id="main-content">
    <div class="profile">
      <div class="profile_inner">
        <img class="profile-avatar" draggable="false" src="/img/portrait.webp" alt={`${SITE.author} 的头像`} width="180" height="180">
        <h1>Merisk</h1>
        <div class="profile-quote" id="quote"></div>
        <span>
          这里记录想法、技术、游戏与生活。文章按标签整理，也可以直接搜索；旧站的文章地址保持原样。
          <br>
          <strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </span>

        <div class="buttons">
          <a class="button" href="/posts.html">全部文章 →</a>
          <button class="button" type="button" id="random-post" data-posts={postPool}>随机逛一篇</button>
          <a class="button" href="/AboutMe.html">关于我</a>
        </div>

        <div class="profile-stats" aria-label="站点概览">
          <span><b>{posts.length}</b> 篇文章</span>
          <span><b>{tagGroups.length}</b> 个标签</span>
          <span><b>{yearCount}</b> 个年份</span>
          <span>更新至 <b>{formatDate(latest.data.date)}</b></span>
        </div>

        <div class="social-icons">
          <a href={SITE.github} target="_blank" rel="noopener noreferrer me" title="GitHub" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 2.5-.34c.85 0 1.71.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"></path></svg>
            <span>GitHub</span>
          </a>
          <a href={SITE.bilibili} target="_blank" rel="noopener noreferrer me" title="Bilibili" aria-label="Bilibili">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="6.5" width="19" height="13" rx="3.2"></rect><path d="M7 3.5 9.6 6.5"></path><path d="M17 3.5 14.4 6.5"></path><path d="M8.2 11.4v3"></path><path d="M15.8 11.4v3"></path></svg>
            <span>Bilibili</span>
          </a>
          <a class="icon-only" href={`mailto:${SITE.email}`} title="Email" aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.4"></rect><path d="m4 7.5 8 5.6 8-5.6"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
  const quotes = ['「一生经过彷徨的挣扎 自信可改变未来 问谁又能做到」','你是从什么途径来到我的博客的？','你所热爱的，就是你的生活。','「有时天使的翅膀并不意味着救赎」','「过往的失败是成就未来的蓝图」','「原谅我这一生不羁放纵爱自由，也会怕有一天会跌倒」','「不需要被认可，但想要被关心。」','「平凡人预测未来… 梦想家塑造未来」','「我曾经失落失望失掉所有方向，直到看见平凡才是唯一的答案」','卡门。我找到他了… -《鬼与女武神（上）》'];
  const quoteNode = document.getElementById('quote');
  if(quoteNode) quoteNode.textContent = quotes[Math.floor(Math.random() * quotes.length)];

  const randomButton = document.getElementById('random-post');
  if(randomButton){
    randomButton.addEventListener('click', () => {
      try{
        const pool = JSON.parse(randomButton.dataset.posts || '[]');
        if(pool.length) window.location.href = pool[Math.floor(Math.random() * pool.length)];
      }catch(e){}
    });
  }
  </script>
</BaseLayout>
