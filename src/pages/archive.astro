---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl, formatDate, formatMonthDay, formatYear, listingSummary } from '../utils';

const posts = await getPosts();
const yearNames = [...new Set(posts.map((post) => formatYear(post.data.date)))];
const postsByYear = yearNames.map((year) => ({
  year,
  items: posts.filter((post) => formatYear(post.data.date) === year),
}));
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;
const taggedCount = posts.filter((post) => post.data.tags.length > 0).length;
---

<BaseLayout title="归档" description="按年份浏览 Merisk'B1og 的全部文章。" bodyClass="single">
  <main class="main container" id="main-content">
    <article class="post-single">
      <header class="post-header">
        <div class="breadcrumbs">
          <a href="/">首页</a>
          <span class="crumb-separator" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"></path></svg>
          </span>
          <span>归档</span>
        </div>
        <h1 class="post-title">归档</h1>
        <div class="post-meta">
          <span>共 {posts.length} 篇文章</span>
          &nbsp;·&nbsp;<span>{postsByYear.length} 个年份</span>
          &nbsp;·&nbsp;<span>{tagCount} 个标签</span>
          &nbsp;·&nbsp;<span>{taggedCount} 篇已标记</span>
        </div>
      </header>

      <div class="post-content">
        <div class="search-toolbar">
          <label class="search-box">
            <span>搜索</span>
            <input id="archive-search" type="search" placeholder="搜索标题、摘要或标签…" autocomplete="off">
          </label>
          <div class="search-count" id="archive-count">{posts.length} 篇文章</div>
        </div>

        <div class="archive-year-filter" id="archive-year-filter" aria-label="年份筛选">
          <button class="tag-filter year-filter active" type="button" data-year="all">全部</button>
          {postsByYear.map((group) => (
            <button class="tag-filter year-filter" type="button" data-year={group.year}>{group.year}</button>
          ))}
        </div>

        <div class="archive-results">
          {postsByYear.map((group) => (
            <section class="archive-year" data-year={group.year}>
              <h2>{group.year}</h2>
              <div class="archive-list">
                {group.items.map((post) => (
                  <a
                    class="archive-entry"
                    href={postUrl(post)}
                    data-year={group.year}
                    data-search={`${post.data.title} ${listingSummary(post)} ${post.data.tags.join(' ')}`.toLowerCase()}
                  >
                    <span class="archive-date" aria-hidden="true">{formatMonthDay(post.data.date)}</span>
                    <span class="archive-main">
                      <span class="archive-entry-title">{post.data.title}</span>
                      {(post.data.summary || post.data.protected) && <small>{listingSummary(post)}</small>}
                      {post.data.tags.length > 0 && (
                        <span class="archive-meta">
                          {post.data.tags.map((tag) => <span class="archive-tag">#{tag}</span>)}
                        </span>
                      )}
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div class="archive-empty" id="archive-empty" hidden>
          <strong>没有找到匹配的文章</strong>
          <span>试试更换关键词或选择其他年份。</span>
          <button class="button" id="archive-reset" type="button">重置筛选</button>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
