---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';
import { getPosts, postSlug, postUrl, formatDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry, index) => {
    const pageTag = entry.data.tags[0];
    const related = pageTag
      ? posts.filter((post) => post.id !== entry.id && post.data.tags.includes(pageTag)).slice(0, 3)
      : [];
    return {
      params: { slug: postSlug(entry) },
      props: {
        entry,
        previous: posts[index + 1] ?? null,
        next: posts[index - 1] ?? null,
        related,
      },
    };
  });
}

const { entry, previous, next, related } = Astro.props;
const { Content } = await render(entry);
const author = entry.data.author ?? SITE.author;
const contentChars = (entry.body ?? '').replace(/<[^>]*>/g, '').replace(/\n/g, '').length;
const readingMinutes = Math.max(1, Math.ceil(contentChars / 400));
---
<BaseLayout title={entry.data.title} description={entry.data.summary ?? SITE.description} type="article">
  <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
  <main class="article-shell" id="main-content">
    <a class="back" href="/#articles" data-back data-fallback="/#articles">
      <span class="back-icon" aria-hidden="true">←</span>
      <span>返回</span>
    </a>

    <article class="article-card">
      <header class="article-title">
        <h1>{entry.data.title}</h1>
        <div class="article-meta">作者:{author} 更新时间:{formatDate(entry.data.date)} · 约 {readingMinutes} 分钟 · {contentChars} 字</div>
        {entry.data.tags.length > 0 && (
          <div class="article-tags">
            {entry.data.tags.map((tag) => <span>#{tag}</span>)}
          </div>
        )}
        <div class="article-share" aria-label="分享文章">
          <button type="button" data-share="copy">复制链接</button>
          <button type="button" data-share="native">分享</button>
          <button type="button" data-share="qq">QQ</button>
        </div>
      </header>

      <div class="article-content">
        <Content />
      </div>

      <nav class="post-navigation" aria-label="文章导航">
        {previous && (
          <a class="post-nav-link prev" href={postUrl(previous)}>
            <small>上一篇</small>
            <strong>{previous.data.title}</strong>
          </a>
        )}
        {next && (
          <a class="post-nav-link next" href={postUrl(next)}>
            <small>下一篇</small>
            <strong>{next.data.title}</strong>
          </a>
        )}
      </nav>

      {related.length > 0 && (
        <section class="related-posts" aria-labelledby="related-posts-title">
          <div class="related-head">
            <div class="section-kicker">Related</div>
            <h2 id="related-posts-title">相关文章</h2>
          </div>
          <div class="related-grid">
            {related.map((post) => (
              <a class="related-card" href={postUrl(post)}>
                <small>{formatDate(post.data.date)}</small>
                <strong>{post.data.title}</strong>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {SITE.giscus.enabled && SITE.giscus.categoryId && (
        <div class="giscus-wrap">
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo={SITE.giscus.repo}
            data-repo-id={SITE.giscus.repoId}
            data-category={SITE.giscus.category}
            data-category-id={SITE.giscus.categoryId}
            data-mapping={SITE.giscus.mapping}
            data-strict={SITE.giscus.strict}
            data-reactions-enabled={SITE.giscus.reactionsEnabled}
            data-emit-metadata={SITE.giscus.emitMetadata}
            data-input-position={SITE.giscus.inputPosition}
            data-theme="dark"
            data-lang={SITE.giscus.lang}
            data-loading={SITE.giscus.loading}
            crossorigin="anonymous"
            async
          ></script>
        </div>
      )}
    </article>
  </main>
</BaseLayout>
