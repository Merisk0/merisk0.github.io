---
import fs from 'node:fs';
import path from 'node:path';
import ArticleView from '../../views/ArticleView.astro';
import { getPosts, postSlug } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const protectedDir = path.join(process.cwd(), 'src', 'data', 'protected');

  const readPayload = (id: string) => {
    const file = path.join(protectedDir, `${id}.json`);
    if (!fs.existsSync(file)) return null;
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  };

  return posts.map((entry, index) => {
    const pageTag = entry.data.tags[0];
    const related = pageTag
      ? posts.filter((post) => post.id !== entry.id && post.data.tags.includes(pageTag)).slice(0, 3)
      : [];
    return {
      params: { slug: postSlug(entry) },
      props: {
        entry,
        previous: posts[index + 1] ?? null,
        next: posts[index - 1] ?? null,
        related,
        payload: entry.data.protected ? readPayload(entry.id) : null,
      },
    };
  });
}

const props = Astro.props;
---

<ArticleView {...props} lang="zh" />
