---
import fs from 'node:fs';
import path from 'node:path';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';
import { getPosts, postSlug, postUrl, formatDate } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const protectedDir = path.join(process.cwd(), 'src', 'data', 'protected');

  const readPayload = (id: string) => {
    const file = path.join(protectedDir, `${id}.json`);
    if (!fs.existsSync(file)) return null;
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  };

  return posts.map((entry, index) => {
    const pageTag = entry.data.tags[0];
    const related = pageTag
      ? posts.filter((post) => post.id !== entry.id && post.data.tags.includes(pageTag)).slice(0, 3)
      : [];
    return {
      params: { slug: postSlug(entry) },
      props: {
        entry,
        previous: posts[index + 1] ?? null,
        next: posts[index - 1] ?? null,
        related,
        payload: entry.data.protected ? readPayload(entry.id) : null,
      },
    };
  });
}

const { entry, previous, next, related, payload } = Astro.props;
const isProtected = Boolean(entry.data.protected);
const rendered = isProtected ? null : await render(entry);
const Content = rendered?.Content ?? null;
const headings = rendered?.headings ?? [];
const author = entry.data.author ?? SITE.author;
const contentChars = (entry.body ?? '').replace(/<[^>]*>/g, '').replace(/\n/g, '').length;
const readingMinutes = Math.max(1, Math.ceil(contentChars / 400));

// 目录：h2 为一级，h3 挂在最近的一级下面
const tocItems: Array<{ slug: string; text: string; children: Array<{ slug: string; text: string }> }> = [];
for (const heading of headings) {
  if (heading.depth === 2) {
    tocItems.push({ slug: heading.slug, text: heading.text, children: [] });
  } else if (heading.depth === 3) {
    const last = tocItems[tocItems.length - 1];
    if (last) last.children.push({ slug: heading.slug, text: heading.text });
    else tocItems.push({ slug: heading.slug, text: heading.text, children: [] });
  }
}
---

<BaseLayout title={entry.data.title} description={isProtected ? '已加密，需要密码查看' : (entry.data.summary ?? SITE.description)} type="article" bodyClass="single">
  <main class="main container" id="main-content">
    <article class="post-single">
      <header class="post-header">
        <div class="breadcrumbs">
          <a href="/">首页</a>
          <span class="crumb-separator" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"></path></svg>
          </span>
          <a href="/posts.html">文章</a>
          <span class="crumb-separator" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"></path></svg>
          </span>
          <span class="crumb-current" aria-current="page">{entry.data.title}</span>
        </div>
        <h1 class="post-title">{entry.data.title}</h1>
        <div class="post-meta">
          <span>{formatDate(entry.data.date)}</span>
          &nbsp;·&nbsp;
          {isProtected
            ? <span>已加密</span>
            : <><span>约 {readingMinutes} 分钟</span>&nbsp;·&nbsp;<span>{contentChars} 字</span>&nbsp;·&nbsp;<span>{author}</span></>
          }
        </div>
      </header>

      {tocItems.length > 0 && (
        <>
          {/* 宽屏：右侧固定目录 */}
          <nav class="toc-side" data-toc-side aria-label="文章目录">
            <ul>
              {tocItems.map((item) => (
                <li>
                  <a href={`#${item.slug}`}>{item.text}</a>
                  {item.children.length > 0 && (
                    <ul>
                      {item.children.map((child) => (
                        <li><a href={`#${child.slug}`}>{child.text}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>

          {/* 中窄屏：正文上方的折叠目录 */}
          <div class="toc-inline">
            <details>
              <summary><span class="details">目录</span></summary>
              <div class="inner">
                <ul>
                  {tocItems.map((item) => (
                    <li>
                      <a href={`#${item.slug}`}>{item.text}</a>
                      {item.children.length > 0 && (
                        <ul>
                          {item.children.map((child) => (
                            <li><a href={`#${child.slug}`}>{child.text}</a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </div>
        </>
      )}

      {isProtected ? (
        <>
          <div class="article-lock" id="article-lock">
            <div class="article-lock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="10.5" width="16" height="10" rx="2.6"></rect>
                <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path>
                <circle cx="12" cy="15.6" r="1.25"></circle>
              </svg>
            </div>
            <h2>这篇文章已加密</h2>
            <p>请输入访问密码查看正文</p>
            <form class="article-lock-form" id="article-lock-form">
              <input id="article-lock-password" type="password" autocomplete="current-password" placeholder="输入密码" aria-label="访问密码" required>
              <button type="submit">解锁</button>
            </form>
            <p class="article-lock-error" id="article-lock-error" hidden>密码不正确，请重试</p>
          </div>
          <div class="post-content" id="article-content" hidden></div>
          <script type="application/json" id="article-lock-payload" set:html={JSON.stringify(payload)}></script>
        </>
      ) : (
        <div class="post-content">
          {Content && <Content />}
        </div>
      )}

      <footer class="post-footer">
        <div class="article-share" aria-label="分享文章">
          <button type="button" data-share="copy">复制链接</button>
          <button type="button" data-share="native">分享</button>
          <button type="button" data-share="qq">QQ</button>
        </div>
        {entry.data.tags.length > 0 && (
          <ul class="post-tags">
            {entry.data.tags.map((tag) => (
              <li><a href={`/tags.html#tag-${tag}`}>#{tag}</a></li>
            ))}
          </ul>
        )}
      </footer>

      <nav class="post-nav" aria-label="文章导航">
        {previous ? (
          <a class="post-nav-button prev" href={postUrl(previous)}>
            <span>上一篇</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span class="post-nav-button prev disabled">
            <span>上一篇</span>
            <strong>没有了</strong>
          </span>
        )}
        {next ? (
          <a class="post-nav-button next" href={postUrl(next)}>
            <span>下一篇</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span class="post-nav-button next disabled">
            <span>下一篇</span>
            <strong>没有了</strong>
          </span>
        )}
      </nav>

      {related.length > 0 && (
        <section class="related-posts" aria-labelledby="related-posts-title">
          <div class="related-head">
            <h2 id="related-posts-title">相关文章</h2>
          </div>
          <div class="related-grid">
            {related.map((post) => (
              <a class="related-card" href={postUrl(post)}>
                <small>{formatDate(post.data.date)}</small>
                <strong>{post.data.title}</strong>
              </a>
            ))}
          </div>
        </section>
      )}

      {SITE.giscus.enabled && SITE.giscus.categoryId && (
        <div
          class="giscus-wrap"
          data-giscus="1"
          data-giscus-repo={SITE.giscus.repo}
          data-giscus-repo-id={SITE.giscus.repoId}
          data-giscus-category={SITE.giscus.category}
          data-giscus-category-id={SITE.giscus.categoryId}
          data-giscus-mapping={SITE.giscus.mapping}
          data-giscus-strict={SITE.giscus.strict}
          data-giscus-reactions-enabled={SITE.giscus.reactionsEnabled}
          data-giscus-emit-metadata={SITE.giscus.emitMetadata}
          data-giscus-input-position={SITE.giscus.inputPosition}
          data-giscus-lang={SITE.giscus.lang}
          data-giscus-loading={SITE.giscus.loading}
        ></div>
      )}
    </article>
  </main>
</BaseLayout>
